  # Width of a character in a font variant (em). Falls back by class.
  def self.width(char : Char, variant : String = "main") : Float64
    if (g = glyph(char, variant))
      g.width
    elsif char.ascii_letter?
      0.52
    elsif char.ascii_number?
      0.5
    elsif char.whitespace?
      0.25
    else
      0.55
    end
  end

  def self.glyph(char : Char, variant : String = "main") : Glyph?
    table = TABLE[variant]? || TABLE["main"]? || return nil
    table[char.ord.to_u32!]? || (TABLE["main"]? || return nil)[char.ord.to_u32!]?
  end

  def self.height(char : Char, variant : String = "main") : Float64
    glyph(char, variant).try(&.height) || 0.45
  end

  def self.depth(char : Char, variant : String = "main") : Float64
    glyph(char, variant).try(&.depth) || 0.0
  end
