# Regression guard for the Wikipedia 1000-formula integration dataset.
# Compares mathjax.cr trees against reference MathML generated by real
# MathJax (tools/make_reference.js). Skipped when the dataset is absent.
require "./spec_helper"
require "../tools/compare_norm"

DATASET = "test/datasets/wikipedia_ref.jsonl"

describe "wikipedia dataset (1-to-1 vs MathJax)" do
  next pending "dataset not present (fetch with tools/fetch_formulas.cr)" unless File.exists?(DATASET)

  it "parses >= 99% of formulas" do
    total = 0
    parsed = 0
    File.each_line(DATASET) do |line|
      next if line.strip.empty?
      item = JSON.parse(line)
      total += 1
      begin
        MathJax.parse(item["tex"].as_s)
        parsed += 1
      rescue MathJax::TeX::TexError
      end
    end
    (parsed * 100 / total).should be >= 99
  end

  it "produces structurally identical trees for >= 98% of comparable formulas" do
    total = 0
    comparable = 0
    equal = 0
    File.each_line(DATASET) do |line|
      next if line.strip.empty?
      item = JSON.parse(line)
      total += 1
      ref_mml = item["mml_ref"]?.try(&.as_s?)
      next if item["ref_error"]?.try(&.as_s?)
      next if ref_mml.nil?
      next if ref_mml.includes?("merror") # MathJax noundefined fakes
      comparable += 1
      begin
        ours = MathJax.parse(item["tex"].as_s)
        ref = MathJax.from_mathml(ref_mml)
        equal += 1 if Compare.diff(Compare.normalize(ours), Compare.normalize(ref)).nil?
      rescue MathJax::TeX::TexError
      end
    end
    (equal * 100 / comparable).should be >= 98
  end
end
